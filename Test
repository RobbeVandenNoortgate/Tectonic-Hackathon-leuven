    function openExpertModal(name, role) {
      document.getElementById('modalExpertName').innerText = name;
      document.getElementById('modalExpertRole').innerText = role;
      document.getElementById('modalExpertInitials').innerText = name.split(' ').map(n=>n[0]).join('');
      document.getElementById('expertModal').classList.remove('hidden');
      lucide.createIcons();
    }

    function closeExpertModal() {
      document.getElementById('expertModal').classList.add('hidden');
    }

    function sendExpertInquiry() {
      const expertName = document.getElementById('modalExpertName').innerText;
      closeExpertModal();
      showToast(
        "Teams Sessie Gestart", 
        `Er is een direct chatbericht verstuurd naar ${expertName} inclusief documentcontext en trust-diagnose.`
      );
    }

    function resolveConflict(actionText) {
      showToast("Conflict Opgelost", `De recentere Teams-bron is als leidend aangemerkt. Het document wordt opnieuw gegenereerd.`);
    }

    function triggerVerification() {
      closeInspector();
      showToast("Verificatie Aangevraagd", "Een notificatie is verstuurd naar het Legal & Compliance team voor hercertificering.");
    }

    function reportConflict() {
      closeInspector();
      showToast("Tegenstrijdigheid Gemeld", "Het Knowledge Management team zal deze case binnen 24 uur analyseren.");
    }

    // ==========================================
    // TOAST NOTIFICATIONS
    // ==========================================
    let toastTimeout;
    function showToast(title, message) {
      clearTimeout(toastTimeout);
      const toast = document.getElementById('toastNotification');
      document.getElementById('toastTitle').innerText = title;
      document.getElementById('toastMessage').innerText = message;

      toast.classList.remove('translate-y-24', 'opacity-0');
      toast.classList.add('translate-y-0', 'opacity-100');

      toastTimeout = setTimeout(() => {
        dismissToast();
      }, 4500);
    }

    function dismissToast() {
      const toast = document.getElementById('toastNotification');
      toast.classList.add('translate-y-24', 'opacity-0');
      toast.classList.remove('translate-y-0', 'opacity-100');
    }

    // Keyboard shortcut for Cmd/Ctrl + K
    window.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        const searchInput = document.getElementById('globalSearchInput');
        searchInput.focus();
        searchInput.select();
      }
      if (e.key === 'Escape') {
        closeInspector();
        closeExpertModal();
      }
    });

    // Initialize on page load
    window.onload = function() {
      renderDocuments();
      runSimulation();
      lucide.createIcons();
    };
  </script>
</body>
</html>
