    // ==========================================
    // TRUST SCORE CALCULATION ALGORITHM
    // ==========================================
    function calculateTrustScore(authorRole, ageMonths, sourceType, jurisdictionMatch, peerReviewed, hasConflict) {
      // 1. Author Expertise (Weight: 30%)
      let authorScore = 30;
      if (authorRole === 'legal_lead') authorScore = 98;
      else if (authorRole === 'senior_consultant') authorScore = 85;
      else if (authorRole === 'junior_consultant') authorScore = 60;
      else if (authorRole === 'intern') authorScore = 35;
      else if (authorRole === 'unknown') authorScore = 15;

      // 2. Recency & Legal Validity (Weight: 25%)
      // Decay curves: fresh < 3 months is optimal, decays significantly after 12 months
      let recencyScore = 100;
      if (ageMonths <= 3) {
        recencyScore = 100 - (ageMonths * 2);
      } else if (ageMonths <= 12) {
        recencyScore = 94 - ((ageMonths - 3) * 4);
      } else if (ageMonths <= 24) {
        recencyScore = 58 - ((ageMonths - 12) * 2.5);
      } else {
        recencyScore = Math.max(10, 28 - ((ageMonths - 24) * 1.5));
      }

      // 3. Jurisdiction & Scope Match (Weight: 20%)
      let jurisdictionScore = 100;
      if (jurisdictionMatch === 'exact') jurisdictionScore = 100;
      else if (jurisdictionMatch === 'generic') jurisdictionScore = 65;
      else if (jurisdictionMatch === 'mismatch') jurisdictionScore = 20;

      // 4. Source & Consensus (Weight: 25%)
      let consensusScore = 50;
      if (sourceType === 'official_portal') consensusScore = 95;
      else if (sourceType === 'sharepoint_managed') consensusScore = 75;
      else if (sourceType === 'onenote_personal') consensusScore = 40;
      else if (sourceType === 'teams_chat') consensusScore = 25;

      if (peerReviewed) consensusScore = Math.min(100, consensusScore + 20);

      // Conflict penalty
      let conflictPenalty = 0;
      if (hasConflict) {
        conflictPenalty = 35;
      }

      // Weighted Total
      const weightedRaw = (authorScore * 0.30) + (recencyScore * 0.25) + (jurisdictionScore * 0.20) + (consensusScore * 0.25);
      const finalScore = Math.max(5, Math.min(99, Math.round(weightedRaw - conflictPenalty)));

      return {
        total: finalScore,
        author: Math.round(authorScore),
        recency: Math.round(recencyScore),
        jurisdiction: Math.round(jurisdictionScore),
        consensus: Math.round(consensusScore),
        hasConflict: hasConflict
      };
    }

