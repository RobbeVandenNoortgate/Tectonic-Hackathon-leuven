<!DOCTYPE html>
<html lang="nl" class="h-full bg-slate-50">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SD Worx TrustHub — Explainable Knowledge Trust Engine</title>
  
  <!-- Fonts & Frameworks -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Lucide Icons CDN -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
          },
          colors: {
            sd: {
              navy: '#0b1d3a',
              blue: '#0052cc',
              royal: '#1e40af',
              cyan: '#06b6d4',
              teal: '#0d9488',
              surface: '#f8fafc',
              border: '#e2e8f0',
              accent: '#f97316'
            }
          }
        }
      }
    }
  </script>

  <style>
    /* Custom gauge and transition styling */
    .gauge-circle {
      transition: stroke-dashoffset 0.8s ease-in-out, stroke 0.4s ease;
      transform: rotate(-90deg);
      transform-origin: 50% 50%;
    }
    
    .glass-card {
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(12px);
    }
    
    .gradient-hero {
      background: linear-gradient(135deg, #0b1d3a 0%, #152e5a 60%, #1a365d 100%);
    }

    /* Custom scrollbars */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #f1f5f9;
    }
    ::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }

    @keyframes pulseSoft {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.65; }
    }
    .pulse-soft {
      animation: pulseSoft 2.5s infinite ease-in-out;
    }
  </style>
</head>
<body class="h-full text-slate-800 antialiased flex flex-col selection:bg-blue-100 selection:text-blue-900">

  <!-- Navigation Bar -->
  <header class="sticky top-0 z-40 bg-white/95 backdrop-blur border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16 gap-4">
        
        <!-- Logo & Brand -->
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-blue-700 to-indigo-900 flex items-center justify-center text-white shadow-md shadow-blue-900/20 font-bold text-lg tracking-wider">
            SD
          </div>
          <div>
            <div class="flex items-center gap-2">
              <span class="font-extrabold text-slate-900 tracking-tight text-lg">Trust<span class="text-blue-600">Hub</span></span>
              <span class="px-2 py-0.5 text-[10px] font-bold tracking-wide uppercase bg-blue-50 text-blue-700 border border-blue-200 rounded-full">Hackathon PoC</span>
            </div>
            <p class="text-[11px] text-slate-500 font-medium hidden sm:block">SD Worx Knowledge Trust & Verification Engine</p>
          </div>
        </div>

        <!-- Global Quick Search Bar -->
        <div class="flex-1 max-w-xl hidden md:block">
          <div class="relative">
            <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2"></i>
            <input 
              id="globalSearchInput"
              type="text" 
              placeholder="Zoek HR wetgeving, CAO 200, maaltijdcheques, thuiswerk..." 
              class="w-full pl-10 pr-10 py-2 bg-slate-100 hover:bg-slate-50 focus:bg-white text-sm border border-transparent focus:border-blue-500 rounded-xl transition duration-150 outline-none"
              oninput="handleSearch(this.value)"
            >
            <span class="absolute right-3 top-1/2 -translate-y-1/2 text-[10px] font-mono bg-slate-200/70 text-slate-600 px-1.5 py-0.5 rounded border border-slate-300">⌘K</span>
          </div>
        </div>

        <!-- Country selector & Profile -->
        <div class="flex items-center gap-3">
          <!-- Active Country Jurisdiction Filter -->
          <div class="flex items-center gap-1.5 bg-slate-100 p-1 rounded-xl border border-slate-200">
            <button onclick="setJurisdiction('BE')" id="pill-BE" class="jurisdiction-pill px-2.5 py-1 text-xs font-semibold rounded-lg bg-white text-blue-700 shadow-sm border border-slate-200">🇧🇪 BE</button>
            <button onclick="setJurisdiction('NL')" id="pill-NL" class="jurisdiction-pill px-2.5 py-1 text-xs font-medium rounded-lg text-slate-600 hover:text-slate-900">🇳🇱 NL</button>
            <button onclick="setJurisdiction('DE')" id="pill-DE" class="jurisdiction-pill px-2.5 py-1 text-xs font-medium rounded-lg text-slate-600 hover:text-slate-900">🇩🇪 DE</button>
            <button onclick="setJurisdiction('ALL')" id="pill-ALL" class="jurisdiction-pill px-2.5 py-1 text-xs font-medium rounded-lg text-slate-600 hover:text-slate-900">🌍 Alle</button>
          </div>

          <!-- Notification indicator for Conflicts -->
          <button onclick="switchTab('conflicts')" class="relative p-2 rounded-xl text-slate-600 hover:bg-slate-100 border border-transparent hover:border-slate-200 transition" title="2 Gedetecteerde tegenstrijdigheden">
            <i data-lucide="shield-alert" class="w-5 h-5 text-amber-600"></i>
            <span class="absolute top-1.5 right-1.5 w-2 h-2 rounded-full bg-amber-500 ring-2 ring-white animate-ping"></span>
            <span class="absolute top-1.5 right-1.5 w-2 h-2 rounded-full bg-amber-500 ring-2 ring-white"></span>
          </button>

          <!-- User session preview -->
          <div class="flex items-center gap-2 pl-2 border-l border-slate-200">
            <div class="w-8 h-8 rounded-full bg-blue-100 text-blue-800 font-bold flex items-center justify-center text-xs border border-blue-200">
              SV
            </div>
            <div class="hidden lg:block text-left">
              <p class="text-xs font-semibold text-slate-800 leading-tight">Sarah V.</p>
              <p class="text-[10px] text-slate-500">Payroll Consultant</p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </header>

  <!-- Context Banner / Hackathon Challenge Framing -->
  <section class="gradient-hero text-white py-8 px-4 sm:px-6 lg:px-8 shadow-inner relative overflow-hidden">
    <!-- Subtle background accent elements -->
    <div class="absolute -right-12 -top-12 w-64 h-64 bg-blue-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute right-1/3 -bottom-20 w-80 h-80 bg-teal-500/10 rounded-full blur-3xl pointer-events-none"></div>
    
    <div class="max-w-7xl mx-auto relative z-10">
      <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
        <div class="max-w-3xl">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/20 text-blue-200 border border-blue-400/30 text-xs font-semibold mb-3">
            <i data-lucide="sparkles" class="w-3.5 h-3.5 text-cyan-300"></i>
            <span>Challenge: From "I found something" to "I know why I can rely on it"</span>
          </div>
          <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white mb-2">
            Verklaarbare Betrouwbaarheid voor HR & Payroll Kennis
          </h1>
          <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
            Elimineer twijfel bij dringende klantvragen. TrustHub berekent realtime een dynamische trust-score op basis van auteursexpertise, documentleeftijd, contextuele wetgeving en geautomatiseerde conflict-detectie met Teams chats en SharePoint policies.
          </p>
        </div>

        <!-- Live Trust Health Metric Cards -->
        <div class="grid grid-cols-3 gap-3 self-stretch lg:self-center">
          <div class="bg-white/10 backdrop-blur-md rounded-2xl p-3.5 border border-white/15 flex flex-col justify-center">
            <span class="text-xs text-slate-300 font-medium">Geverifieerde Kennis</span>
            <div class="flex items-baseline gap-1 mt-1">
              <span class="text-2xl font-black text-white">87%</span>
              <span class="text-[10px] text-emerald-400 font-bold">↑ 4.2%</span>
            </div>
            <span class="text-[10px] text-slate-400 mt-0.5">PC 200 & Fiscaal</span>
          </div>
          
          <div class="bg-white/10 backdrop-blur-md rounded-2xl p-3.5 border border-white/15 flex flex-col justify-center">
            <span class="text-xs text-amber-200 font-medium">Conflicten Alert</span>
            <div class="flex items-baseline gap-1 mt-1">
              <span class="text-2xl font-black text-amber-300">2</span>
              <span class="text-[10px] text-amber-300 font-bold">Actie vereist</span>
            </div>
            <span class="text-[10px] text-slate-400 mt-0.5">Teams vs Policy</span>
          </div>

          <div class="bg-white/10 backdrop-blur-md rounded-2xl p-3.5 border border-white/15 flex flex-col justify-center">
            <span class="text-xs text-cyan-200 font-medium">Gem. Kennis-Score</span>
            <div class="flex items-baseline gap-1 mt-1">
              <span class="text-2xl font-black text-cyan-300">79</span>
              <span class="text-[10px] text-slate-300 font-normal">/100</span>
            </div>
            <span class="text-[10px] text-slate-400 mt-0.5">Betrouwbaar niveau</span>
          </div>
        </div>
      </div>

      <!-- Navigation Tabs -->
      <div class="flex items-center gap-2 mt-6 pt-4 border-t border-white/10 overflow-x-auto text-sm">
        <button onclick="switchTab('explorer')" id="tab-explorer" class="tab-button flex items-center gap-2 px-4 py-2 rounded-xl font-bold bg-white text-slate-900 shadow-sm transition">
          <i data-lucide="library" class="w-4 h-4 text-blue-600"></i>
          <span>Documenten & Trust Inspectie</span>
        </button>
        <button onclick="switchTab('simulator')" id="tab-simulator" class="tab-button flex items-center gap-2 px-4 py-2 rounded-xl font-medium text-slate-300 hover:text-white hover:bg-white/10 transition">
          <i data-lucide="sliders" class="w-4 h-4 text-cyan-400"></i>
          <span>Trust Simulator Sandbox</span>
          <span class="px-1.5 py-0.5 text-[10px] bg-cyan-500/30 text-cyan-200 rounded-md">Interactief</span>
        </button>
        <button onclick="switchTab('conflicts')" id="tab-conflicts" class="tab-button flex items-center gap-2 px-4 py-2 rounded-xl font-medium text-slate-300 hover:text-white hover:bg-white/10 transition">
          <i data-lucide="alert-triangle" class="w-4 h-4 text-amber-400"></i>
          <span>Conflict & Tegenstrijdigheid Radar</span>
          <span class="w-2 h-2 rounded-full bg-amber-400"></span>
        </button>
        <button onclick="switchTab('about')" id="tab-about" class="tab-button flex items-center gap-2 px-4 py-2 rounded-xl font-medium text-slate-300 hover:text-white hover:bg-white/10 transition">
          <i data-lucide="lightbulb" class="w-4 h-4 text-yellow-300"></i>
          <span>Hackathon Pitch & Methodologie</span>
        </button>
      </div>
    </div>
  </section>

  <!-- MAIN CONTENT CONTAINER -->
  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">

    <!-- ========================================== -->
    <!-- TAB 1: DOCUMENTEN & TRUST VERKENNER -->
    <!-- ========================================== -->
    <div id="view-explorer" class="view-panel space-y-6">
      
      <!-- Filter Bar -->
      <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
        
        <!-- Filter Pills -->
        <div class="flex flex-wrap items-center gap-2">
          <span class="text-xs font-bold text-slate-500 uppercase tracking-wider mr-1">Domein:</span>
          <button onclick="setDomainFilter('ALL')" id="filter-domain-ALL" class="domain-filter-btn px-3 py-1.5 text-xs font-semibold rounded-xl bg-slate-900 text-white shadow-sm">Alle Domeinen</button>
          <button onclick="setDomainFilter('Payroll')" id="filter-domain-Payroll" class="domain-filter-btn px-3 py-1.5 text-xs font-medium rounded-xl bg-slate-100 text-slate-600 hover:bg-slate-200">Payroll & Salaris</button>
          <button onclick="setDomainFilter('Legal')" id="filter-domain-Legal" class="domain-filter-btn px-3 py-1.5 text-xs font-medium rounded-xl bg-slate-100 text-slate-600 hover:bg-slate-200">Arbeidsrecht & Legal</button>
          <button onclick="setDomainFilter('Fiscaal')" id="filter-domain-Fiscaal" class="domain-filter-btn px-3 py-1.5 text-xs font-medium rounded-xl bg-slate-100 text-slate-600 hover:bg-slate-200">Fiscaal & Voordelen</button>
          <button onclick="setDomainFilter('Policy')" id="filter-domain-Policy" class="domain-filter-btn px-3 py-1.5 text-xs font-medium rounded-xl bg-slate-100 text-slate-600 hover:bg-slate-200">Intern Beleid</button>
        </div>

        <!-- Trust Threshold Selector -->
        <div class="flex items-center gap-3 self-end md:self-auto">
          <label for="trustThreshold" class="text-xs font-medium text-slate-600 flex items-center gap-1.5">
            <i data-lucide="shield" class="w-3.5 h-3.5 text-blue-600"></i>
            Min. Betrouwbaarheid:
          </label>
          <select id="trustThreshold" onchange="handleTrustThresholdChange(this.value)" class="text-xs font-semibold bg-slate-100 border border-slate-200 rounded-xl px-3 py-1.5 text-slate-700 outline-none focus:border-blue-500">
            <option value="0">Alles tonen (0% - 100%)</option>
            <option value="80">Hoge betrouwbaarheid (≥ 80%)</option>
            <option value="60">Matig & Goedgekeurd (≥ 60%)</option>
            <option value="risks">Alleen Risico's & Conflicten (&lt; 60%)</option>
          </select>
        </div>

      </div>

      <!-- Quick Feedback Alert Banner -->
      <div id="resultsCountBanner" class="text-xs text-slate-500 font-medium px-1 flex items-center justify-between">
        <span>Toont <span id="displayedDocsCount" class="font-bold text-slate-900">4</span> documenten in de geselecteerde context</span>
        <span class="text-slate-400 italic">Klik op een document voor de transparante score-verklaring & expertconnectie</span>
      </div>

      <!-- Document Cards Grid -->
      <div id="documentsGrid" class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Rendered dynamically by JavaScript -->
      </div>

    </div>

    <!-- ========================================== -->
    <!-- TAB 2: INTERACTIEVE TRUST SIMULATOR (SANDBOX) -->
    <!-- ========================================== -->
    <div id="view-simulator" class="view-panel hidden space-y-6">
      <div class="bg-blue-50 border border-blue-200 rounded-2xl p-5">
        <div class="flex items-start gap-3">
          <div class="w-9 h-9 rounded-xl bg-blue-600 text-white flex items-center justify-center shrink-0 shadow">
            <i data-lucide="sliders" class="w-5 h-5"></i>
          </div>
          <div>
            <h2 class="text-base font-bold text-slate-900">SD Worx Trust Algorithm Simulator</h2>
            <p class="text-xs text-slate-600 mt-0.5 leading-relaxed">
              Hoe weet een consultant of een document betrouwbaar is? Pas de parameters hieronder aan om te zien hoe de 4 pijlers (Auteur, Actualiteit, Jurisdictie en Consensus) samenwerken om een verklaarbare score te vormen.
            </p>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        
        <!-- Controls Panel (Left) -->
        <div class="lg:col-span-7 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-6">
          <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider flex items-center gap-2">
            <i data-lucide="settings-2" class="w-4 h-4 text-blue-600"></i>
            Kennisparameters Aanpassen
          </h3>

          <!-- Param 1: Auteur Job/Rol -->
          <div>
            <div class="flex justify-between items-center mb-1.5">
              <label class="text-xs font-bold text-slate-700">1. Auteur & Functieniveau</label>
              <span id="simAuthorWeight" class="text-[11px] font-bold text-blue-700 bg-blue-50 px-2 py-0.5 rounded-full">Gewicht: 30%</span>
            </div>
            <select id="simAuthorRole" onchange="runSimulation()" class="w-full text-sm font-medium bg-slate-50 border border-slate-300 rounded-xl p-2.5 focus:border-blue-500 focus:bg-white outline-none">
              <option value="legal_lead">Lead Subject Matter Expert / Legal Counsel (SD Worx BE)</option>
              <option value="senior_consultant">Senior Payroll Specialist (5+ jaar ervaring)</option>
              <option value="junior_consultant">Junior HR Consultant (&lt; 1 jaar ervaring)</option>
              <option value="intern">Stagiair / Externe Freelancer</option>
              <option value="unknown">Onbekend / Automatische Teams Chat export</option>
            </select>
            <p class="text-[11px] text-slate-500 mt-1">Hogere autoriteit en geverifieerd vakmanschap garanderen fundamentele validiteit.</p>
          </div>

          <!-- Param 2: Leeftijd van het document -->
          <div>
            <div class="flex justify-between items-center mb-1">
              <label class="text-xs font-bold text-slate-700">2. Documentleeftijd & Actualiteit</label>
              <span id="simAgeDisplay" class="text-xs font-bold text-slate-900 font-mono">2 maanden oud</span>
            </div>
            <input 
              id="simDocAge" 
              type="range" 
              min="0" 
              max="36" 
              value="2" 
              step="1"
              oninput="updateAgeDisplay(this.value); runSimulation()" 
              class="w-full accent-blue-600 cursor-pointer h-2 bg-slate-200 rounded-lg"
            >
            <div class="flex justify-between text-[10px] text-slate-400 mt-1 font-medium">
              <span>Nieuw (deze maand)</span>
              <span>12 mnd (CAO cyclus)</span>
              <span>24 mnd</span>
              <span>36+ mnd (Groot verouderingsrisico)</span>
            </div>
          </div>

          <!-- Param 3: Brontype & Opslaglocatie -->
          <div>
            <label class="text-xs font-bold text-slate-700 block mb-1.5">3. Bron & Publicatiekanaal</label>
            <select id="simSourceType" onchange="runSimulation()" class="w-full text-sm font-medium bg-slate-50 border border-slate-300 rounded-xl p-2.5 focus:border-blue-500 focus:bg-white outline-none">
              <option value="official_portal">Officieel SD Worx Kennisportaal / CAO Richtlijn</option>
              <option value="sharepoint_managed">Gemanagede Afdelings-SharePoint (HR Advisory BE)</option>
              <option value="onenote_personal">Persoonlijke OneNote / Lokale Klantnotitie</option>
              <option value="teams_chat">Onofficiële Teams Chat conversatie snippet</option>
            </select>
          </div>

          <!-- Param 4: Jurisdictie Match -->
          <div>
            <label class="text-xs font-bold text-slate-700 block mb-1.5">4. Jurisdictie & Doelgroep Match</label>
            <div class="grid grid-cols-3 gap-2">
              <label class="flex items-center gap-2 p-2.5 rounded-xl border border-slate-200 bg-slate-50 cursor-pointer hover:border-blue-300">
                <input type="radio" name="simJurisdiction" value="exact" checked onchange="runSimulation()" class="accent-blue-600">
                <span class="text-xs font-medium text-slate-800">Exact (PC 200 BE)</span>
              </label>
              <label class="flex items-center gap-2 p-2.5 rounded-xl border border-slate-200 bg-slate-50 cursor-pointer hover:border-blue-300">
                <input type="radio" name="simJurisdiction" value="generic" onchange="runSimulation()" class="accent-blue-600">
                <span class="text-xs font-medium text-slate-800">Algemeen EU/NL</span>
              </label>
              <label class="flex items-center gap-2 p-2.5 rounded-xl border border-slate-200 bg-slate-50 cursor-pointer hover:border-blue-300">
                <input type="radio" name="simJurisdiction" value="mismatch" onchange="runSimulation()" class="accent-blue-600">
                <span class="text-xs font-medium text-slate-800">Ander Land/Sector</span>
              </label>
            </div>
          </div>

          <!-- Param 5: Validatie & Tegenstrijdigheden -->
          <div class="p-3.5 bg-slate-50 rounded-xl border border-slate-200 space-y-3">
            <label class="text-xs font-bold text-slate-700 block">5. Validatiestempel & Conflict Signalen</label>
            
            <div class="flex items-center justify-between">
              <span class="text-xs text-slate-700 font-medium">Officiële peer-review door 2e consultant</span>
              <input type="checkbox" id="simPeerReview" checked onchange="runSimulation()" class="w-4 h-4 accent-blue-600 rounded cursor-pointer">
            </div>

            <div class="flex items-center justify-between pt-2 border-t border-slate-200">
              <div>
                <span class="text-xs text-rose-700 font-bold block">Tegenstrijdigheid gedetecteerd in Teams?</span>
                <span class="text-[10px] text-slate-500">Collega deelt recent afwijkende info in chat</span>
              </div>
              <input type="checkbox" id="simConflictDetected" onchange="runSimulation()" class="w-4 h-4 accent-rose-600 rounded cursor-pointer">
            </div>
          </div>

        </div>

        <!-- Live Score Output (Right) -->
        <div class="lg:col-span-5 flex flex-col gap-4">
          <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex-1 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Live Trust Evaluatie</span>
                <span id="simStatusPill" class="px-2.5 py-1 text-xs font-bold rounded-full bg-emerald-100 text-emerald-800 border border-emerald-200">
                  Goudstandaard
                </span>
              </div>

              <!-- Radial Gauge Simulator -->
              <div class="flex flex-col items-center justify-center my-4">
                <div class="relative w-40 h-40 flex items-center justify-center">
                  <svg class="w-full h-full" viewBox="0 0 100 100">
                    <circle cx="50" cy="50" r="42" stroke="#f1f5f9" stroke-width="9" fill="none" />
                    <circle 
                      id="simGaugeMeter"
                      cx="50" cy="50" r="42" 
                      stroke="#10b981" 
                      stroke-width="9" 
                      fill="none" 
                      stroke-dasharray="264" 
                      stroke-dashoffset="20"
                      stroke-linecap="round"
                      class="gauge-circle"
                    />
                  </svg>
                  <div class="absolute inset-0 flex flex-col items-center justify-center">
                    <span id="simScoreText" class="text-4xl font-extrabold text-slate-900 tracking-tight">92%</span>
                    <span class="text-[10px] uppercase font-bold text-slate-400 tracking-wider">Trust Score</span>
                  </div>
                </div>

                <p id="simRecommendation" class="text-xs text-center font-medium text-slate-600 mt-2 max-w-xs">
                  Veilig te delen met klanten. Alle wettelijke controles en auteursexpertise zijn gegarandeerd.
                </p>
              </div>

              <!-- Breakdown 4 Pillars -->
              <div class="space-y-2.5 pt-3 border-t border-slate-100">
                <div class="flex items-center justify-between text-xs">
                  <span class="text-slate-600 flex items-center gap-1.5">
                    <i data-lucide="user-check" class="w-3.5 h-3.5 text-blue-600"></i> Auteursexpertise
                  </span>
                  <div class="flex items-center gap-2">
