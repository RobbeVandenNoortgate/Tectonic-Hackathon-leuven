    function runSimulation() {
      const authorRole = document.getElementById('simAuthorRole').value;
      const ageMonths = parseInt(document.getElementById('simDocAge').value);
      const sourceType = document.getElementById('simSourceType').value;
      const jurisdictionMatch = document.querySelector('input[name="simJurisdiction"]:checked').value;
      const peerReviewed = document.getElementById('simPeerReview').checked;
      const hasConflict = document.getElementById('simConflictDetected').checked;

      const calc = calculateTrustScore(authorRole, ageMonths, sourceType, jurisdictionMatch, peerReviewed, hasConflict);

      // Update text & scores
      document.getElementById('simScoreText').innerText = `${calc.total}%`;
      document.getElementById('simValAuthor').innerText = `${calc.author}%`;
      document.getElementById('simValRecency').innerText = `${calc.recency}%`;
      document.getElementById('simValJurisdiction').innerText = `${calc.jurisdiction}%`;
      document.getElementById('simValConsensus').innerText = `${calc.consensus}%`;

      // Update Bars
      document.getElementById('simBarAuthor').style.width = `${calc.author}%`;
      document.getElementById('simBarRecency').style.width = `${calc.recency}%`;
      document.getElementById('simBarJurisdiction').style.width = `${calc.jurisdiction}%`;
      document.getElementById('simBarConsensus').style.width = `${calc.consensus}%`;

      // Update Gauge
      const meter = document.getElementById('simGaugeMeter');
      const offset = 264 - (264 * (calc.total / 100));
      meter.style.strokeDashoffset = offset;

      // Styling based on score
      let color = '#10b981';
      let pillText = 'Goudstandaard';
      let pillClass = 'bg-emerald-100 text-emerald-800 border-emerald-200';
      let recommendation = 'Veilig te delen met klanten. Alle wettelijke controles en auteursexpertise zijn gegarandeerd.';
      let explanation = `<strong>Waarom deze score (${calc.total}%)?</strong> Dit document geniet hoge betrouwbaarheid dankzij sterke autoriteit en actuele validatie.`;

      if (calc.total < 45) {
        color = '#f43f5e';
        pillText = 'Hoog Risico';
        pillClass = 'bg-rose-100 text-rose-800 border-rose-200';
        recommendation = 'Niet gebruiken voor extern advies. Vraag eerst een review aan een Senior SME.';
        explanation = `<strong>Waarschuwing (${calc.total}%):</strong> `;
        if (calc.hasConflict) {
          explanation += `Er is een actieve tegenstrijdigheid gedetecteerd (-35% boete). `;
        }
        if (calc.recency < 40) {
          explanation += `Het document is sterk verouderd en stemt vermoedelijk niet meer overeen met de huidige wetgeving. `;
        }
        if (calc.author < 30) {
          explanation += `De auteur heeft geen gecertificeerde rol voor dit domein.`;
        }
      } else if (calc.total < 75) {
        color = '#f59e0b';
        pillText = 'Voorzichtig';
        pillClass = 'bg-amber-100 text-amber-800 border-amber-200';
        recommendation = 'Geschikt voor intern overleg, maar controleer de recentste wetswijzigingen voor klantbevestiging.';
        explanation = `<strong>Aandachtspunten (${calc.total}%):</strong> De basis is bruikbaar, maar de betrouwbaarheid kan verhoogd worden door een formele peer-review of validatie door een erkende Lead.`;
      }

      meter.setAttribute('stroke', color);
      const pill = document.getElementById('simStatusPill');
      pill.innerText = pillText;
      pill.className = `px-2.5 py-1 text-xs font-bold rounded-full border ${pillClass}`;
      document.getElementById('simRecommendation').innerText = recommendation;
      document.getElementById('simExplanationBox').innerHTML = explanation;
    }

